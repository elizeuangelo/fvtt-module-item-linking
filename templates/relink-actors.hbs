<form autocomplete="off">
    <p class="notes">Please choose the target Compendium Packs and the world Actor Compendiums to fix. Locked Actor Compendiums are unlocked for the fix and locked again when the results are closed.</p>
    <div class="form-group">
        <label>{{ localize "Item Compendiums" }}</label>
        <div class="form-fields">
            <select name="packs" multiple="multiple" required>
                {{selectOptions packs nameAttr="id" labelAttr="name"}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label>{{ localize "Actor Compendiums" }}</label>
        <div class="form-fields">
            <select name="actorPacks" multiple="multiple" required>
                {{selectOptions actorPacks nameAttr="id" labelAttr="name"}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label>{{ localize "Filter By Type" }}</label>
        <div class="form-fields">
            <select name="typeFilter">
                <option id=""></option>
                {{selectOptions types}}
            </select>
        </div>
    </div>
    <fieldset>
        <legend>{{ localize "Relink Options" }}</legend>
        <div class="form-group">
            <label>Hide Unmatched Items</label>
            <input type="checkbox" name="hideUnmatched" checked />
        </div>
        <div class="form-group">
            <label>Hide NPCs</label>
            <input type="checkbox" name="hideNpcs" checked />
        </div>
    </fieldset>
</form>